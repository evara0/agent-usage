{
  "name": "agent-usage",
  "version": "0.1.0",
  "description": "Local Codex Skill evidence statistics CLI",
  "type": "module",
  "bin": {
    "agent-usage": "dist/index.mjs",
    "skillusage": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/codex.test.js .test-dist/tests/contracts.test.js",
    "test:cli": "tsdown && node --test tests/cli.test.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "codex",
    "skills",
    "analytics",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^25.9.3",
    "acorn": "^8.15.0",
    "cli-table3": "^0.6.5",
    "gunshi": "^0.34.0",
    "picocolors": "^1.1.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
